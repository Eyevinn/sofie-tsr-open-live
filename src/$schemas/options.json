{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"title": "Open Live Options",
	"type": "object",
	"properties": {
		"url": { "type": "string", "ui:title": "Open Live backend URL", "ui:description": "Full https address of the Open Live backend, for example magnus-mylive.eyevinn-open-live.auto.prod-se.osaas.io", "default": "" },
		"productionId": { "type": "string", "ui:title": "Production ID", "default": "" },
		"authMode": {
			"type": "string",
			"ui:title": "Authentication",
			"enum": ["none", "apiKey", "osc"],
			"tsEnumNames": ["None", "ApiKey", "Osc"],
			"default": "osc"
		},
		"apiKey": { "type": "string", "ui:title": "API key (self-hosted Open Live)", "ui:sensitive": true, "default": "" },
		"oscPat": { "type": "string", "ui:title": "OSC Personal Access Token", "ui:sensitive": true, "default": "" },
		"oscServiceId": { "type": "string", "ui:title": "OSC service ID", "default": "eyevinn-open-live" },
		"ackTimeoutMs": { "type": "integer", "ui:title": "ACK timeout (ms)", "default": 5000, "minimum": 100 },
		"keepAliveIntervalMs": { "type": "integer", "ui:title": "Keep-alive interval (ms, 0 = off)", "default": 30000, "minimum": 0 }
	},
	"required": ["url", "productionId"],
	"additionalProperties": false
}
